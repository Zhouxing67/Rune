<UserControl
    x:Class="Rune.Controls.NoteCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="{StaticResource NoteCardWidth}" KeyDown="Root_KeyDown">
    <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMedium}" Padding="14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Note" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                        Click="Close_Click" AutomationProperties.Name="Close note" ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="240">
                <TextBlock x:Name="ReadText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
            <TextBox x:Name="EditText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="120" MaxHeight="240" Visibility="Collapsed" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
                <Button x:Name="EditButton" Content="Edit" Click="Edit_Click" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
