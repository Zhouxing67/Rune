<UserControl
    x:Class="Rune.Controls.SelectionToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource OverlayPillStyle}" Padding="4" Height="{StaticResource SelectionToolbarHeight}">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Style="{StaticResource OverlayIconButtonStyle}" Click="Highlight_Click"
                    AutomationProperties.Name="Highlight selection" ToolTipService.ToolTip="Highlight">
                <FontIcon Glyph="&#xE891;" FontSize="16" Foreground="#FFC99A00" />
            </Button>
            <Button Style="{StaticResource OverlayIconButtonStyle}" Click="Underline_Click"
                    AutomationProperties.Name="Underline selection" ToolTipService.ToolTip="Underline">
                <FontIcon Glyph="&#xE8DC;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource OverlayIconButtonStyle}" Click="Strikeout_Click"
                    AutomationProperties.Name="Strike out selection" ToolTipService.ToolTip="Strikeout">
                <FontIcon Glyph="&#xE8D2;" FontSize="16" />
            </Button>
            <Border Style="{StaticResource HeaderSeparatorStyle}" />
            <Button Style="{StaticResource OverlayIconButtonStyle}" Click="Copy_Click"
                    AutomationProperties.Name="Copy selection" ToolTipService.ToolTip="Copy (Ctrl+C)">
                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
            </Button>
            <Button Style="{StaticResource OverlayIconButtonStyle}" Click="Note_Click"
                    AutomationProperties.Name="Add note to selection" ToolTipService.ToolTip="Add note">
                <FontIcon Glyph="&#xE70B;" FontSize="16" Foreground="#FFFFC107" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
