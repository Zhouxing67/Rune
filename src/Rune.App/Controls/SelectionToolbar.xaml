<UserControl
    x:Class="Rune.Controls.SelectionToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SelectionToolbarSurfaceStyle}"
            Padding="5,3" Height="{StaticResource SelectionToolbarHeight}">
        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <Button Style="{StaticResource SelectionToolbarButtonStyle}" Click="Highlight_Click"
                    AutomationProperties.Name="Highlight selection" ToolTipService.ToolTip="Highlight">
                <FontIcon Glyph="&#xE891;" FontSize="{StaticResource SelectionToolbarGlyphSize}"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Button>
            <Button Style="{StaticResource SelectionToolbarButtonStyle}" Click="Underline_Click"
                    AutomationProperties.Name="Underline selection" ToolTipService.ToolTip="Underline">
                <FontIcon Glyph="&#xE8DC;" FontSize="{StaticResource SelectionToolbarGlyphSize}" />
            </Button>
            <Button Style="{StaticResource SelectionToolbarButtonStyle}" Click="Strikeout_Click"
                    AutomationProperties.Name="Strike out selection" ToolTipService.ToolTip="Strikeout">
                <FontIcon Glyph="&#xE8D2;" FontSize="{StaticResource SelectionToolbarGlyphSize}" />
            </Button>
            <Border Style="{StaticResource SelectionToolbarSeparatorStyle}" />
            <Button Style="{StaticResource SelectionToolbarButtonStyle}" Click="Copy_Click"
                    AutomationProperties.Name="Copy selection" ToolTipService.ToolTip="Copy (Ctrl+C)">
                <FontIcon Glyph="&#xE8C8;" FontSize="{StaticResource SelectionToolbarGlyphSize}" />
            </Button>
            <Button Style="{StaticResource SelectionToolbarButtonStyle}" Click="Note_Click"
                    AutomationProperties.Name="Add note to selection" ToolTipService.ToolTip="Add note">
                <FontIcon Glyph="&#xE70B;" FontSize="{StaticResource SelectionToolbarGlyphSize}"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
