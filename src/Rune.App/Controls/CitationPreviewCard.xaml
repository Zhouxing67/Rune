<UserControl
    x:Class="Rune.Controls.CitationPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="{StaticResource CitationCardWidth}">
    <Border Style="{StaticResource OverlayCardSurfaceStyle}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MinHeight="42" Padding="14,6,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reference" Style="{StaticResource ControlTitleTextStyle}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Margin="8,0,0,0" Padding="7,2"
                        VerticalAlignment="Center" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="PageLabel" Style="{StaticResource CaptionTextStyle}" />
                </Border>
                <Button Grid.Column="3" HorizontalAlignment="Right"
                        Style="{StaticResource CompactIconButtonStyle}"
                        Click="Close_Click" AutomationProperties.Name="Close reference preview"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource CompactGlyphSize}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="12,0" Padding="12,10"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer MaxHeight="164" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReferenceText" TextWrapping="WrapWholeWords"
                               IsTextSelectionEnabled="True" Style="{StaticResource BodyTextStyle}" LineHeight="20"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" MinHeight="42" Padding="8,4">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="OpenLinkButton" Click="OpenLink_Click"
                            Visibility="Collapsed" Style="{StaticResource CompactTextButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="{StaticResource CompactGlyphSize}" />
                            <TextBlock Text="Open link" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Click="GoTo_Click" Style="{StaticResource AccentButtonStyle}"
                            MinHeight="{StaticResource CompactButtonSize}" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Go to reference" FontSize="{StaticResource TextCaptionSize}" />
                            <FontIcon Glyph="&#xE72A;" FontSize="{StaticResource CompactGlyphSize}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
