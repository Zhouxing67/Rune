<UserControl
    x:Class="Rune.Controls.CitationPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420">
    <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE82D;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Reference preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Width="30" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="Close_Click" ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ReferenceText" TextWrapping="WrapWholeWords"
                           IsTextSelectionEnabled="True" LineHeight="21" />
            </ScrollViewer>

            <Grid Grid.Row="2">
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="OpenLinkButton" Content="Open link" Click="OpenLink_Click" Visibility="Collapsed" />
                    <Button Content="Go to reference" Style="{StaticResource AccentButtonStyle}" Click="GoTo_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
