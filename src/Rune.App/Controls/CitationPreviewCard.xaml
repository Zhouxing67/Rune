<UserControl
    x:Class="Rune.Controls.CitationPreviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="{StaticResource CitationCardWidth}">
    <Border Style="{StaticResource OverlayCardSurfaceStyle}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Reference" Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                        Click="Close_Click" AutomationProperties.Name="Close reference preview"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="168" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ReferenceText" TextWrapping="WrapWholeWords"
                           IsTextSelectionEnabled="True" FontSize="13" LineHeight="18" />
            </ScrollViewer>

            <Grid Grid.Row="2">
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="OpenLinkButton" Content="Open" Click="OpenLink_Click"
                            Visibility="Collapsed" MinHeight="32" Padding="10,4" />
                    <Button Content="Go to" Style="{StaticResource AccentButtonStyle}"
                            Click="GoTo_Click" MinHeight="32" Padding="10,4" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
