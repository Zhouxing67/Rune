<!-- Design tokens: the ONLY place new spacing/radius/size constants may be
     defined. GNOME-HIG-inspired scale (4/8/12/16/24) on Fluent controls. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="HomeCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="HomeCardBorderBrush" Color="#FFDADADA" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#F7FAFAFA" />
            <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FAFFFFFF" />
            <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#24000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="HomeCardBackgroundBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="HomeCardBorderBrush" Color="#FF424242" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#F72A2A2A" />
            <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FA303030" />
            <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#F2383838" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#32FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PanelSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing scale -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>

    <!-- Component scale: three sizes only. -->
    <x:Double x:Key="HeaderHeight">52</x:Double>
    <x:Double x:Key="ToolbarButtonSize">36</x:Double>
    <x:Double x:Key="CompactButtonSize">30</x:Double>
    <x:Double x:Key="TouchButtonSize">40</x:Double>
    <x:Double x:Key="IconButtonSize">36</x:Double>
    <x:Double x:Key="IconGlyphSize">17</x:Double>
    <x:Double x:Key="CompactGlyphSize">14</x:Double>
    <x:Double x:Key="ToolbarSearchWidth">300</x:Double>
    <x:Double x:Key="ToolbarGroupGap">8</x:Double>

    <!-- Fluent's minimum comfortable touch target. The 34px header buttons are
         deliberately left below it: they sit in a 44px bar with 2px gaps, so a
         finger that misses one hits its neighbour rather than nothing, and
         widening them would loosen the proportions the header is built on. It
         is the controls that float alone — the zoom pill, the find bar, the
         sidebar switcher — where a miss hits the page instead, and those are
         sized from here. -->
    <x:Double x:Key="TouchTargetMin">40</x:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">18</CornerRadius>

    <!-- Notice card: wide enough for two lines of message text, narrow enough
         to stay a card rather than becoming a full-width bar. -->
    <x:Double x:Key="NoticeMaxWidth">520</x:Double>

    <!-- Homepage cards -->
    <Thickness x:Key="HomePagePadding">72,64,72,44</Thickness>
    <!-- ColumnDefinition.Width requires GridLength. A Double compiles but
         throws XamlParseException while MainWindow is being constructed. -->
    <GridLength x:Key="HomeColumnGap">56</GridLength>
    <x:Double x:Key="HomeCardHeight">74</x:Double>
    <x:Double x:Key="CardWidth">168</x:Double>
    <x:Double x:Key="CardHeight">212</x:Double>

    <!-- Pen options panel -->
    <x:Double x:Key="InkSwatchSize">32</x:Double>
    <x:Double x:Key="HeaderSeparatorHeight">20</x:Double>

    <!-- Sidebar. Thumbnail boxes take their height from each page's own aspect
         ratio; the clamps keep a poster (1:10) or a banner (10:1) usable. -->
    <x:Double x:Key="SidebarWidth">288</x:Double>
    <x:Double x:Key="OutlineRowHeight">40</x:Double>
    <!-- ColumnDefinition.Width is GridLength, not Double. Because outline
         templates are realized lazily, a Double resource compiles but throws
         XamlParseException the first time the Chapters pane is opened. -->
    <GridLength x:Key="OutlinePageWidth">48</GridLength>
    <x:Double x:Key="OutlineIndent">20</x:Double>
    <x:Double x:Key="SidebarThumbWidth">240</x:Double>
    <x:Double x:Key="SidebarThumbMinHeight">96</x:Double>
    <x:Double x:Key="SidebarThumbMaxHeight">320</x:Double>

    <!-- Selection/search/note overlays. Kept here so their proportions stay
         consistent in both themes and at every call site. -->
    <x:Double x:Key="OverlayButtonSize">30</x:Double>
    <x:Double x:Key="SelectionToolbarHeight">40</x:Double>
    <x:Double x:Key="SelectionToolbarButtonSize">32</x:Double>
    <x:Double x:Key="SelectionToolbarGlyphSize">17</x:Double>
    <x:Double x:Key="SelectionToolbarGap">8</x:Double>
    <CornerRadius x:Key="SelectionToolbarRadius">8</CornerRadius>
    <CornerRadius x:Key="SelectionToolbarButtonRadius">4</CornerRadius>
    <x:Double x:Key="SearchResultPanelWidth">360</x:Double>
    <x:Double x:Key="NoteMarkerVisualSize">14</x:Double>
    <x:Double x:Key="NoteMarkerHitSize">28</x:Double>
    <x:Double x:Key="NoteCardWidth">320</x:Double>
    <x:Double x:Key="CitationCardWidth">372</x:Double>

    <!-- Dialog and typography roles. -->
    <x:Double x:Key="DialogWidthCompact">320</x:Double>
    <x:Double x:Key="DialogWidthNormal">420</x:Double>
    <x:Double x:Key="DialogWidthWide">680</x:Double>
    <x:Double x:Key="DialogMaxWidthWide">800</x:Double>
    <x:Double x:Key="ToolFlyoutWidth">360</x:Double>
    <x:Double x:Key="ToolFlyoutMinWidth">240</x:Double>
    <x:Double x:Key="SwatchRingSize">30</x:Double>
    <x:Double x:Key="SwatchDotSize">22</x:Double>
    <x:Double x:Key="TextDisplaySize">28</x:Double>
    <x:Double x:Key="TextSectionSize">20</x:Double>
    <x:Double x:Key="TextControlTitleSize">14</x:Double>
    <x:Double x:Key="TextBodySize">14</x:Double>
    <x:Double x:Key="TextSecondarySize">13</x:Double>
    <x:Double x:Key="TextCaptionSize">12</x:Double>
</ResourceDictionary>
