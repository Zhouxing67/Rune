<Window
    x:Class="Rune.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rune.Controls"
    Title="Rune">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chrome-style: the tab strip IS the title bar. Tabs carry no
             content (documents render in DocHost below); the footer is the
             window drag region, padded clear of the caption buttons. -->
        <!-- CloseButtonOverlayMode is Always, not Auto: Auto reveals a background
             tab's close button on hover, and a finger cannot hover, so closing
             one meant selecting it first. -->
        <TabView
            x:Name="Tabs"
            Grid.Row="0"
            VerticalAlignment="Top"
            TabWidthMode="Equal"
            CloseButtonOverlayMode="Always"
            SelectionChanged="Tabs_SelectionChanged"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested">
            <TabView.TabStripHeader>
                <!-- The wordmark is an idempotent Home button: it shows the
                     recents screen without closing any document. Returning to
                     a PDF always requires choosing its tab explicitly. -->
                <!-- MinHeight/MinWidth because the caption-sized wordmark alone
                     gave it a target about 20px tall, and it is the only way
                     back to the recents screen. -->
                <Button
                    x:Name="HomeButton"
                    Click="HomeButton_Click"
                    VerticalAlignment="Center"
                    Margin="8,0,4,0"
                    Padding="10,2"
                    MinHeight="{StaticResource TouchTargetMin}"
                    MinWidth="{StaticResource TouchTargetMin}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    AutomationProperties.Name="Home" ToolTipService.ToolTip="Home — recent documents">
                    <TextBlock
                        Text="Rune"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragArea" Background="Transparent" MinWidth="188" />
            </TabView.TabStripFooter>
        </TabView>

        <!-- Header bar (GNOME Papers proportions): one slim row of flat icon
             buttons; everything else lives in the hamburger menu. -->
        <Grid
            x:Name="Toolbar"
            Grid.Row="1"
            Height="{StaticResource HeaderHeight}"
            Padding="8,0"
            ColumnSpacing="2">
            <!-- Left group = view state (sidebar, page, fit, rotate);
                 right group = actions (find, pen, night, menu). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                x:Name="SidebarButton"
                Grid.Column="0"
                Style="{StaticResource IconToggleButtonStyle}"
                Click="SidebarButton_Click"
                IsEnabled="False"
                AutomationProperties.Name="Show sidebar" ToolTipService.ToolTip="Show sidebar (F9)">
                <FontIcon Glyph="&#xE8A0;" FontSize="{StaticResource IconGlyphSize}" />
            </ToggleButton>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
                <NumberBox
                    x:Name="PageBox"
                    AutomationProperties.Name="Page number"
                    Minimum="1"
                    SpinButtonPlacementMode="Hidden"
                    IsEnabled="False"
                    MinWidth="52"
                    VerticalAlignment="Center"
                    ValueChanged="PageBox_ValueChanged" />
                <TextBlock
                    x:Name="PageCountLabel"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource HeaderSeparatorStyle}" Margin="8,0,4,0" />

            <ToggleButton
                x:Name="FitWidthButton"
                Grid.Column="3"
                Style="{StaticResource IconToggleButtonStyle}"
                Click="FitWidthButton_Click"
                IsEnabled="False"
                AutomationProperties.Name="Fit width" ToolTipService.ToolTip="Fit width (Ctrl+2)">
                <FontIcon Glyph="&#xE9A6;" FontSize="{StaticResource IconGlyphSize}" />
            </ToggleButton>
            <ToggleButton
                x:Name="FitPageButton"
                Grid.Column="4"
                Style="{StaticResource IconToggleButtonStyle}"
                Click="FitPageButton_Click"
                IsEnabled="False"
                AutomationProperties.Name="Fit page" ToolTipService.ToolTip="Fit page (Ctrl+0)">
                <FontIcon Glyph="&#xE9A6;" FontSize="{StaticResource IconGlyphSize}" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="90" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </ToggleButton>
            <Button
                x:Name="RotateLeftButton"
                Grid.Column="5"
                Style="{StaticResource IconButtonStyle}"
                Click="RotateLeftButton_Click"
                IsEnabled="False"
                AutomationProperties.Name="Rotate left" ToolTipService.ToolTip="Rotate left (Ctrl+Shift+R)">
                <!-- Mirrored rotate-right glyph, so the pair always matches. -->
                <FontIcon Glyph="&#xE7AD;" FontSize="{StaticResource IconGlyphSize}" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <Button
                x:Name="RotateRightButton"
                Grid.Column="6"
                Style="{StaticResource IconButtonStyle}"
                Click="RotateButton_Click"
                IsEnabled="False"
                AutomationProperties.Name="Rotate right" ToolTipService.ToolTip="Rotate right (Ctrl+R)">
                <FontIcon Glyph="&#xE7AD;" FontSize="{StaticResource IconGlyphSize}" />
            </Button>

            <!-- Annotation tools, centred in the toolbar's empty middle column
                 (Snipping Tool's arrangement). Exactly one is armed at a time;
                 clicking one opens its options directly beneath it. -->
            <!-- Spans every column rather than sitting in the empty middle one:
                 the left group is much wider than the right, so centring within
                 the gap would leave the cluster visibly off-centre in the
                 window. Overlaying and centring across the whole row puts it
                 where the eye expects. -->
            <StackPanel
                Grid.Column="0"
                Grid.ColumnSpan="12"
                Orientation="Horizontal"
                Spacing="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ToggleButton
                    x:Name="PenToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="PenToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Pen" ToolTipService.ToolTip="Pen — draw freehand (Ctrl+E)">
                    <FontIcon Glyph="&#xE70F;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
                <ToggleButton
                    x:Name="HighlighterToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="HighlighterToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Highlighter" ToolTipService.ToolTip="Highlighter — drag over text (Ctrl+H)">
                    <FontIcon Glyph="&#xE891;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
                <ToggleButton
                    x:Name="NoteToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="NoteToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Sticky note" ToolTipService.ToolTip="Note — click to add a sticky note">
                    <FontIcon Glyph="&#xE70B;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
                <ToggleButton
                    x:Name="TextToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="TextToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Text" ToolTipService.ToolTip="Text — click anywhere on the page and type (Ctrl+T)">
                    <FontIcon Glyph="&#xE8D2;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ImageToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="ImageToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Picture" ToolTipService.ToolTip="Picture — place an image on the page (Ctrl+wheel resizes it)">
                    <FontIcon Glyph="&#xEB9F;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
                <ToggleButton
                    x:Name="SignToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="SignToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Sign" ToolTipService.ToolTip="Sign — place your signature">
                    <FontIcon Glyph="&#xEE56;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
                <ToggleButton
                    x:Name="EraserToolButton"
                    Style="{StaticResource IconToggleButtonStyle}"
                    Click="EraserToolButton_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Eraser" ToolTipService.ToolTip="Eraser — click an annotation to remove it">
                    <FontIcon Glyph="&#xE75C;" FontSize="{StaticResource IconGlyphSize}" />
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="8" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2">
                <Button x:Name="HistoryBackButton" Style="{StaticResource IconButtonStyle}"
                        Click="HistoryBackButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Alt+Left)">
                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconGlyphSize}" />
                </Button>
                <Button x:Name="HistoryForwardButton" Style="{StaticResource IconButtonStyle}"
                        Click="HistoryForwardButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward (Alt+Right)">
                    <FontIcon Glyph="&#xE72A;" FontSize="{StaticResource IconGlyphSize}" />
                </Button>
                <Button x:Name="FindButton" Style="{StaticResource IconButtonStyle}"
                        Click="FindButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Find in document" ToolTipService.ToolTip="Find in document (Ctrl+F)">
                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconGlyphSize}" />
                </Button>
            </StackPanel>
            <Button
                x:Name="MenuButton"
                Grid.Column="10"
                Grid.ColumnSpan="2"
                Style="{StaticResource IconButtonStyle}"
                AutomationProperties.Name="Menu" ToolTipService.ToolTip="Menu">
                <FontIcon Glyph="&#xE700;" FontSize="{StaticResource IconGlyphSize}" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open…" Click="OpenButton_Click" KeyboardAcceleratorTextOverride="Ctrl+O">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="UndoMenuItem" Text="Undo" Click="UndoMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Z">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="RedoMenuItem" Text="Redo" Click="RedoMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Y">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7A6;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SaveMenuItem" Text="Save" Click="SaveButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+S">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="Save as…" Click="SaveAsButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PrintMenuItem" Text="Print…" Click="PrintButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+P">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE749;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ShareMenuItem" Text="Share…" Click="ShareMenuItem_Click" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="FlattenMenuItem" Text="Flatten annotations…" Click="FlattenMenuItem_Click" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="PresentMenuItem" Text="Presentation" Click="PresentMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="F5">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <!-- Bookmarking and the palette were chords and nothing
                             else, and the empty bookmarks pane told the user to
                             press one. A tablet has no chords. -->
                        <MenuFlyoutItem x:Name="BookmarkMenuItem" Text="Bookmark this page" Click="BookmarkMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+B">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE718;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PaletteMenuItem" Text="Find a command…" Click="PaletteMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+K">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE721;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SignaturesMenuItem" Text="Signature details…" Click="SignaturesMenuItem_Click" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Document properties" Click="PropertiesButton_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+D">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ShortcutsMenuItem" Text="Keyboard shortcuts" Click="ShortcutsMenuItem_Click" KeyboardAcceleratorTextOverride="F1">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE765;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings" Click="SettingsButton_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!-- Rune collects nothing and phones nowhere, so a bug
                             only reaches the developer if the user sends it. -->
                        <MenuFlyoutItem x:Name="ReportProblemMenuItem" Text="Report a problem…" Click="ReportProblemMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE939;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <!-- The selected tab's DocumentView is swapped in here. -->
            <ContentControl
                x:Name="DocHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <!-- A newly selected lazy tab used to present an empty page until
                 PDFium finished opening it, which looked like an ignored click.
                 Keep the selection response visible without blocking the tab
                 strip or pretending that the document is already ready. -->
            <Grid
                x:Name="TabLoadingOverlay"
                Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="28" Height="28" />
                    <TextBlock
                        x:Name="TabLoadingLabel"
                        Text="Opening document…"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Easy PDF-inspired home workspace: actions on the left, compact
                 recent documents on the right. Rune has no separate page
                 organizer, so that reference-only entry is intentionally absent. -->
            <Grid x:Name="StartPage"
                  MaxWidth="1728"
                  Margin="0,72,0,60"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="20" Margin="0,0,0,56">
                    <Image Source="/Assets/Square150x150Logo.scale-100.png" Width="64" Height="64" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Rune" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind VersionLabel}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                    <TextBlock Text="Get started" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,18" />
                    <Button Height="88" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="OpenButton_Click">
                        <Grid Padding="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8E5;" FontSize="28" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Open a local PDF" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Choose a file, or drag one into this window" FontSize="13" Opacity="0.82" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Ctrl + O" FontSize="16" VerticalAlignment="Center" Opacity="0.9" />
                        </Grid>
                    </Button>
                    <Button Height="84" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Click="SettingsButton_Click">
                        <Grid Padding="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="27" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Reading, appearance and application preferences" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="RecentsHeader" Text="Recently opened" FontSize="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,18" />
                    <ListView x:Name="RecentThumbs" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="RecentThumbs_ItemClick" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:RecentCard">
                                <Border Height="86"
                                        Padding="20,0,10,0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        RightTapped="RecentCard_RightTapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8A5;" FontSize="27" VerticalAlignment="Center" Margin="0,0,20,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind LastOpenedText}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                                Click="RecentRemoveButton_Click" ToolTipService.ToolTip="Remove from recents"
                                                AutomationProperties.Name="Remove from recents">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="8" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon Glyph="&#xEA90;" FontSize="42" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No recent documents" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Open a PDF to get started" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="14" Margin="0,48,0,0">
                    <TextBlock Text="Rune — open-source Windows PDF reader" FontSize="13" />
                    <TextBlock Text="Built with .NET, WinUI 3 and PDFium" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Window-level notices: messages that arrive with no document to
                 attach them to (startup problems, a missing recent file, a
                 background failure). Anything about an open document goes to
                 that DocumentView's own NoticeHost instead, which is bounded to
                 the page area so it can't cover the sidebar.

                 Declared before the zoom pill and find bar so active UI always
                 paints over a passive notice, never the other way round. -->
            <controls:NoticeHost x:Name="WindowNotice" />

            <!-- The format bar for the text box being typed into. It floats at
                 the top of the page area, out of the way of a caret that is
                 usually further down, and only exists while a box is open.
                 Its controls are built in code so the font and size lists come
                 from one place (TextBoxFonts) rather than being duplicated in
                 markup that could drift from it. -->
            <Border
                x:Name="TextFormatBar"
                Style="{StaticResource OverlayPillStyle}"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Height="44"
                Padding="8,0">
                <StackPanel
                    x:Name="TextFormatControls"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center" />
            </Border>

            <!-- Floating zoom pill (Papers-style, bottom-right over the page) -->
            <Border
                x:Name="ZoomPill"
                Style="{StaticResource OverlayPillStyle}"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Height="48"
                Padding="4,0">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button
                        x:Name="ZoomOutButton"
                        Style="{StaticResource PillButtonStyle}"
                        Click="ZoomOutButton_Click"
                        IsEnabled="False"
                        AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                        <FontIcon Glyph="&#xE738;" FontSize="14" />
                    </Button>
                    <Button
                        x:Name="ZoomLabelButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Height="{StaticResource TouchTargetMin}"
                        MinWidth="56"
                        Padding="6,0"
                        CornerRadius="20"
                        IsEnabled="False"
                        AutomationProperties.Name="Zoom level" ToolTipService.ToolTip="Zoom level">
                        <TextBlock x:Name="ZoomLabel" Text="100%" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Text="50%" Click="ZoomPreset_Click" Tag="0.5" />
                                <MenuFlyoutItem Text="100%" Click="ZoomPreset_Click" Tag="1.0" KeyboardAcceleratorTextOverride="Ctrl+1" />
                                <MenuFlyoutItem Text="150%" Click="ZoomPreset_Click" Tag="1.5" />
                                <MenuFlyoutItem Text="200%" Click="ZoomPreset_Click" Tag="2.0" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="FitWidthItem" Text="Fit width" Click="FitWidthButton_Click" KeyboardAcceleratorTextOverride="Ctrl+2" />
                                <ToggleMenuFlyoutItem x:Name="FitPageItem" Text="Fit page" Click="FitPageButton_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="ZoomInButton"
                        Style="{StaticResource PillButtonStyle}"
                        Click="ZoomInButton_Click"
                        IsEnabled="False"
                        AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl++)">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Find bar -->
            <Border
                x:Name="FindBar"
                Visibility="Collapsed"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,8,16,0"
                Padding="6"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Width="{StaticResource SearchResultPanelWidth}" MaxHeight="520">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBox
                        x:Name="FindBox"
                        Width="152"
                        PlaceholderText="Find in document"
                        TextChanged="FindBox_TextChanged"
                        KeyDown="FindBox_KeyDown" />
                    <TextBlock
                        x:Name="FindCount"
                        VerticalAlignment="Center"
                        MinWidth="64"
                        Margin="4,0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- These four were the smallest targets in the app, about
                         28x26 from padding alone. Squared off to the touch
                         minimum; the glyphs are unchanged. -->
                    <ToggleButton x:Name="MatchCaseButton" Click="MatchCase_Click" AutomationProperties.Name="Match case" ToolTipService.ToolTip="Match case"
                                  Width="{StaticResource TouchTargetMin}" Height="{StaticResource TouchTargetMin}" Padding="0">
                        <TextBlock Text="Aa" FontSize="13" />
                    </ToggleButton>
                    <Button x:Name="FindPrev" Click="FindPrev_Click" AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous (Shift+Enter)"
                            Width="{StaticResource TouchTargetMin}" Height="{StaticResource TouchTargetMin}" Padding="0">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button x:Name="FindNext" Click="FindNext_Click" AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next (Enter)"
                            Width="{StaticResource TouchTargetMin}" Height="{StaticResource TouchTargetMin}" Padding="0">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                    <Button x:Name="FindClose" Click="FindClose_Click" AutomationProperties.Name="Close find bar" ToolTipService.ToolTip="Close (Esc)"
                            Width="{StaticResource TouchTargetMin}" Height="{StaticResource TouchTargetMin}" Padding="0">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
                    <ListView x:Name="FindResultsList" Grid.Row="1" Margin="0,6,0,0" MaxHeight="400"
                              IsItemClickEnabled="True" ItemClick="FindResultsList_ItemClick"
                              SelectionMode="Single" ItemContainerStyle="{StaticResource SearchResultItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:SearchResultItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Snippet}" TextWrapping="WrapWholeWords" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind PageLabel}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <controls:CommandPalette x:Name="Palette" />
        </Grid>

        <!-- Fullscreen presentation overlay: covers ALL rows (tabs included). -->
        <controls:PresentationView
            x:Name="Presentation"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</Window>
